generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
  CLIENTE
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  PROCESSADO
  CANCELADO
}

enum StatusEquipamento {
  RECEBIDO
  EM_TRIAGEM
  EM_DESMONTAGEM
  TESTE_COMPONENTES
  PRONTO_DESCARTE
  PRONTO_REUSO
  DESCARTE
  REUSO
}

enum TipoOrganizacao {
  gerador
  operador_logistico
  desmontadora
  comprador
}

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  email         String         @unique
  senha         String
  role          Role           @default(OPERADOR)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  movimentacoes Movimentacao[]

  @@map("usuarios")
}

model Organizacao {
  id        String          @id @default(uuid())
  nome      String
  cnpj      String          @unique
  tipo      TipoOrganizacao
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  contrato  Contrato?
  lotes     Lote[]

  @@map("organizacoes")
}

model Contrato {
  id             String      @id @default(uuid())
  numeroContrato String      @unique
  clausulas      Json?
  vigenciaInicio DateTime
  vigenciaFim    DateTime
  organizacaoId  String      @unique
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("contratos")
}

model Lote {
  id              String        @id @default(uuid())
  codigo          String        @unique
  status          StatusLote    @default(RECEBIDO)
  dataRecebimento DateTime      @default(now())
  organizacaoId   String
  organizacao     Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  equipamentos    Equipamento[]

  @@map("lotes")
}

model Equipamento {
  id                  String            @id @default(uuid())
  codigoBarrasInterno String            @unique
  tipo                String
  status              StatusEquipamento @default(RECEBIDO)
  version             Int               @default(0)
  loteId              String
  lote                Lote              @relation(fields: [loteId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  movimentacoes       Movimentacao[]

  @@map("equipamentos")
}

model Movimentacao {
  id             String            @id @default(uuid())
  dataHora       DateTime          @default(now())
  equipamentoId  String
  equipamento    Equipamento       @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  usuarioId      String
  usuario        Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  statusAnterior StatusEquipamento
  statusNovo     StatusEquipamento
  observacao     String?

  @@map("movimentacoes")
}